//#define F_CPU 1000000UL
#include <avr/io.h>
#include <avr/interrupt.h>
#include <util/delay.h>
#include <avr/sleep.h>
#include <stdbool.h>

volatile uint16_t schaltSekunde;
volatile uint16_t sekunden = 50;
volatile uint16_t minuten = 45;
volatile uint16_t stunden = 8;
volatile uint16_t helligkeit = 64;
volatile bool zeiteinstellung = false;

void setZeit(void) {
    ASSR |= (1<< AS2);  // Timer2 auf asynchronen Modus mit externem Quarz setzen
    TCCR2B |= (1 << CS22) | (1 << CS20);  // Vorteiler auf 128 setzen --> 1Hz Timer
    TIMSK2 |= (1 << TOIE2);  // Timer2 Overflow Interrupt aktivieren
}

void pwmSetzen(){
	TCCR1A = (1 << WGM10) | (1 << COM1A1) | (1 << COM1B1); // 8-bit Fast PWM, Clear on Compare Match
    TCCR1B = (1 << WGM12) | (1 << CS11); // Prescaler = 8
    
	OCR1AL = helligkeit;  // PWM-Startwert für OC1A setzen
    OCR1BL = helligkeit;  // PWM-Startwert für OC1B setzen
}

void registerSetzen(){
	DDRB =(1<<PB1)|(1<<PB2);	// PB1 (OC1A) und PB2 (OC1B) als Eingang setzen
	PORTB =(1<<PB1)|(1<<PB1);		//OCA

	DDRD = (1<<PD7)|(1<<PD6)|(1<<PD5)|(PD1<<1)|(1)|(1<<PD2)|(1<<PD3);
	DDRD &= ~(1 << PD4);  // PD4 als Eingang setzen
	PORTD|=(1<<PD2)|(1<<PD3);
	PORTD |= (1 << PD4); 

	DDRC =(1<<PC5)|(1<<PC4)|(1<<PC3)|(1<<PC2)|(1<<PC1)|(1<<PC0);	
}

void setInterrupt(){
	EICRA|=(1<<ISC01)|(1<<ISC11);  // Fallende Flanke an INT0 und INT1
    EIMSK|=(1<<INT0)|(1<<INT1);   // Externe Interrupts INT0 und INT1 aktivieren
}

void zeitanpassung(){
	if(sekunden >=59){
		uint16_t zwischenwert = sekunden / 60;
		sekunden = sekunden - zwischenwert*60;
		minuten = minuten + zwischenwert;
		zwischenwert = minuten / 60;
		minuten = minuten - zwischenwert*60;
		stunden = stunden + zwischenwert;
		zwischenwert = stunden / 24;
		stunden = stunden - zwischenwert*24;
	}
}


void schlafenLegen(){
	PORTC = 0;
	PORTD = (PORTD & 0b00011100) | ((0 & 0x1C)<<3) | (0 & 0x03);
	sleep_mode();
	zeitanpassung();
}

void zeit(){

	if(sekunden >= 60){
		sekunden = 0;
		minuten++;
		if(minuten >= 59){
			minuten = 0;
			stunden++;
			if(stunden >= 24){
				stunden = 0;
			}
			PORTD = (PORTD & 0b00011100) | ((stunden & 0x1C) << 3) | (stunden & 0x03);
		}
		PORTC = minuten;
	}

}


int main () {

	setZeit();
	pwmSetzen();
	registerSetzen();
	setInterrupt();
	sei();

	set_sleep_mode(SLEEP_MODE_PWR_DOWN);
	
	PORTC = minuten;
	PORTD = (PORTD & 0b00011100) | ((stunden & 0x1C)<<3) | (stunden & 0x03);

	int zeitSchlafen = schaltSekunde + 10;

	while (1){
		if(!zeiteinstellung){
			if (schaltSekunde == zeitSchlafen) {  // Wenn PD4 LOW (Button gedrückt)
	        	schlafenLegen();
				zeitSchlafen = schaltSekunde + 10;
			}
			zeit();
	   	} 
		else{
			if (!(PIND & (1 << PD4))) { // Wenn Taster gedrückt (LOW)
				stunden++;  
	            if (stunden >= 24) {
	            	stunden = 0;
	            }
				PORTD = (PORTD & 0b00011100) | ((stunden & 0x1C) << 3) | (stunden & 0x03);
				_delay_ms(250);
			}
			zeitSchlafen = schaltSekunde + 10;
		}
	}
}

//Timer Interupt,kommt jede Sekunde
ISR(TIMER2_OVF_vect) {
		sekunden++;
		schaltSekunde++;
}

//Helligkeitseinsetllung
ISR(INT0_vect){

	if(zeiteinstellung == 1){
		minuten++;
		if(minuten >=60){
			minuten = 0;
		}
		PORTC = minuten;
	}
	else{
		if(helligkeit <= 64){
			helligkeit = 255;
		}
		else{
			helligkeit-=32;
		}
		OCR1AL = helligkeit;  // PWM-Startwert für OC1A setzen
	    OCR1BL = helligkeit;  // PWM-Startwert für OC1B setzen
	}
}


ISR(INT1_vect) {
	if(zeiteinstellung){
		zeiteinstellung = false;
		sekunden = 0;
		schaltSekunde = 0;
	}
	else{
		zeiteinstellung = true;
	}
}
