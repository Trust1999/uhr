#define F_CPU 1000000UL
#include <avr/io.h>
#include <avr/interrupt.h>
#include <util/delay.h>
#include <avr/sleep.h>
#include <stdbool.h>
#include <avr/eeprom.h>

volatile uint16_t schaltSekunde = 0;
volatile uint16_t sekunden = 0;
volatile uint16_t minuten = 01;
volatile uint16_t stunden = 01;
volatile uint16_t helligkeit = 0;
volatile uint16_t zeitSchlafen = 0;
volatile bool zeiteinstellung = false;
volatile bool aktive = true;
volatile bool uhrzeitModus = true;

uint8_t EEMEM gespeicherteHelligkeit; 

void setZeit(void) {

    ASSR |= (1<< AS2);  // Timer2 auf asynchronen Modus mit externem Quarz setzen
    TCCR2B |= (1 << CS22) | (1 << CS20);  // Vorteiler auf 128 setzen --> 1Hz Timer
    TIMSK2 |= (1 << TOIE2);  // Timer2 Overflow Interrupt aktivieren
}

void pwmSetzen(){
	TCCR1A = (1 << WGM10) | (1 << COM1A1) | (1 << COM1B1); // 8-bit Fast PWM, Clear on Compare Match
    TCCR1B = (1 << WGM12) | (1 << CS11); // Prescaler = 8
    
	OCR1AL = helligkeit;  // PWM-Startwert für OC1A setzen
    OCR1BL = helligkeit;  // PWM-Startwert für OC1B setzen
}

void registerSetzen(){
	DDRB =(1<<PB1)|(1<<PB2);	// PB1 (OC1A) und PB2 (OC1B) als Eingang setzen
	PORTB =(1<<PB1)|(1<<PB1);		//OCA

	DDRD = (1<<PD7)|(1<<PD6)|(1<<PD5)|(PD1<<1)|(1)|(1<<PD2)|(1<<PD3);
	DDRD &= ~(1 << PD4);  // PD4 als Eingang setzen
	PORTD|=(1<<PD2)|(1<<PD3);
	PORTD |= (1 << PD4); 

	DDRC =(1<<PC5)|(1<<PC4)|(1<<PC3)|(1<<PC2)|(1<<PC1)|(1<<PC0);	
}

void setInterrupt(){
	EICRA|=(1<<ISC01)|(1<<ISC11);  // Fallende Flanke an INT0 und INT1
    EIMSK|=(1<<INT0)|(1<<INT1);   // Externe Interrupts INT0 und INT1 aktivieren

	PCICR|=(1<<PCIE2);
	PCMSK2|=(1<<PCINT20);
}

void zeitanpassung(){

	while(schaltSekunde >= 50000){
		sekunden++;
		schaltSekunde-=50000;
	}

    uint16_t hinzufuegenMinuten = sekunden / 60;  // Anzahl der Minuten
    uint16_t hinzufuegenStunden = hinzufuegenMinuten / 60;  // Anzahl der Stunden
	
	sekunden = sekunden % 60;  // Reset der Schlafzeit

    minuten += hinzufuegenMinuten;
    stunden += hinzufuegenStunden;

    if (minuten >= 60) {
        stunden += minuten / 60;
        minuten = minuten % 60;
    }

    if (stunden >= 24) {
        stunden = stunden % 24;
    }

	PORTC = minuten;
    PORTD = (PORTD & 0b00011100) | ((stunden & 0x1C) << 3) | (stunden & 0x03);
}


void schlafenLegen(){
	uint16_t letzteHelligkeit = eeprom_read_byte (&gespeicherteHelligkeit);
	
	if (helligkeit != letzteHelligkeit) {
        eeprom_update_byte(&gespeicherteHelligkeit, helligkeit);
    }

	PORTC = 0;
	PORTD = (PORTD & 0b00011100) | ((0 & 0x1C)<<3) | (0 & 0x03);
	aktive = false;
	sleep_mode();
}

void zeit(){
	if(sekunden >= 60){
		sekunden-=60;
		minuten++;

		if(schaltSekunde >= 50000){
			sekunden++;
			PORTD = (PORTD & 0b00011100) | ((stunden & 0x1C) << 3) | (stunden & 0x03);
			schaltSekunde-=50000;
			if(zeitSchlafen > schaltSekunde){
				zeitSchlafen = schaltSekunde + 10;
			}
		}

		if(minuten >= 59){
			minuten = 0;
			stunden++;
			if(stunden >= 24){
				stunden = 0;
			}
			PORTD = (PORTD & 0b00011100) | ((stunden & 0x1C) << 3) | (stunden & 0x03);
		}
		PORTC = minuten;
	}
}

void setup(){
	helligkeit = eeprom_read_byte(&gespeicherteHelligkeit);  // Helligkeit aus EEPROM laden
    if (helligkeit == 0xFF){ // Falls unbeschrieben, Standardwert setzen
		helligkeit = 224;
	}

	setZeit();
	pwmSetzen();
	registerSetzen();
	setInterrupt();
	sei();

	set_sleep_mode(SLEEP_MODE_PWR_SAVE);
	
	PORTC = minuten;
	PORTD = (PORTD & 0b00011100) | ((stunden & 0x1C)<<3) | (stunden & 0x03);

	zeitSchlafen = schaltSekunde + 10;
}

int main () {

	setup();

	while (1){
		if(aktive){
			if(uhrzeitModus && !zeiteinstellung){
				if (schaltSekunde == zeitSchlafen) {
			        	schlafenLegen();
				}
			}
			else{
				asm("nop");
			}
		}
		else{
			sleep_mode();
		}
	}
}

//Timer Interupt,kommt jede Sekunde
ISR(TIMER2_OVF_vect) {
	sekunden++;
	schaltSekunde++;
		
	if(aktive){
		if(!uhrzeitModus){
			PORTC^=(1<<PC5);
			_delay_ms(200);
			PORTC = 0;
		}
		else if(!zeiteinstellung){
			zeit();
		}
	}
}

//Helligkeitseinsetllung
ISR(INT0_vect){
	if(aktive){
		if(zeiteinstellung){
			minuten++;
			if(minuten >=60){
				minuten = 0;
			}
			PORTC = minuten;
		}
		else{
			if(helligkeit <= 64){
				helligkeit = 255;
			}
			else{
				helligkeit-=32;
			}
			OCR1AL = helligkeit;  // PWM-Startwert für OC1A setzen
		    OCR1BL = helligkeit;  // PWM-Startwert für OC1B setzen
		}
	}
	else{
		aktive = true;
		zeitanpassung();
		zeitSchlafen = schaltSekunde + 10;
	}
	_delay_ms(500);
}


ISR(INT1_vect) {
	if(aktive){
		if(uhrzeitModus){
			if(zeiteinstellung){
				zeiteinstellung = false;
				sekunden = 0;
				schaltSekunde = 0;
				zeitSchlafen = schaltSekunde + 10;
			}
			else{
				zeiteinstellung = true;
			}
		}
	}
	else{
		aktive = true;
		zeitanpassung();
		zeitSchlafen = schaltSekunde + 10;
		
	}
	_delay_ms(500);
}

ISR(PCINT2_vect){
	if (!(PIND & (1 << PD4))) { 
		if(aktive){
			if(zeiteinstellung){
				stunden++;  
				if (stunden >= 24) {
				 	stunden = 0;
				}
				PORTD = (PORTD & 0b00011100) | ((stunden & 0x1C) << 3) | (stunden & 0x03);
			}
			else{
				if(uhrzeitModus){
					uhrzeitModus = false;
					PORTC = 0;
					PORTD = (PORTD & 0b00011100) | ((0 & 0x1C)<<3) | (0 & 0x03);
				}
				else{
					uhrzeitModus = true;
					zeitanpassung();
					zeitSchlafen = schaltSekunde + 10;
				}
			}
		}
		else{
			aktive = true;
			zeitanpassung();
			zeitSchlafen = schaltSekunde + 10;
		}
		_delay_ms(500);
	}
}
